APP_NAME=SilverBridge AI Server
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=6017
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=6019
POSTGRES_DB=silverbridge_ai
POSTGRES_USER=silverbridge_ai
POSTGRES_PASSWORD=silverbridge_ai_pw
DATABASE_URL=postgresql+psycopg2://silverbridge_ai:silverbridge_ai_pw@localhost:6019/silverbridge_ai
# 서버 .env 에만 실제 값을 넣는다(저장소·문서에 키를 쓰지 말 것)
API_KEY=<API_KEY>

MODEL_BASE_PATH=/app/models
UPLOAD_BASE_PATH=/app/uploads
SNAPSHOT_BASE_PATH=/app/uploads/snapshots
DEVICE_MAP=auto
TORCH_DTYPE=float16
REQUIRE_GPU=true

DEFAULT_CHAT_MODEL=google/medgemma-1.5-4b-it
CHAT_MODEL_PATH=
# MedGemma 양자화: none(기본, 지금과 같은 bf16) | nf4(4비트, 메모리 약 5GB 절약). nf4 로드가 실패하면 none으로 내려간다.
MEDGEMMA_QUANT=none
# false면 MedGemma를 올리지 않는다(메모리 확보). 의료 채팅은 모델 없는 경로로 간다.
MEDGEMMA_ENABLED=true
HF_TOKEN=

GPT_API_KEY=
GPT_MODEL_NAME=gpt-4o-mini
GPT_TIMEOUT_SEC=60

RESERVATION_API_BASE_URL=http://127.0.0.1:6015/api/v1
RESERVATION_API_TIMEOUT_SEC=120
RESERVATION_API_KEY=
RESERVATION_USER_JWT=
RESERVATION_ADMIN_JWT=
# 옛 공용 예약 계정(기본값 없음, 쓰지 않으면 비워 둔다)
RESERVATION_SERVICE_EMAIL=
RESERVATION_SERVICE_PASSWORD=
# 사용자별 예약 계정 비밀번호 파생 비밀 - 필수(기본값 없음). 프론트 BFF의 RESERVATION_ACCOUNT_SECRET과 같은 값.
# 비어 있으면 병원 예약 기능만 꺼진다(상담·이상감지·클립은 그대로).
RESERVATION_ACCOUNT_SECRET=
# FE에서 발급받은 reservation API key를 저장해 두고 채팅 예약 호출에 재사용합니다.

DEFAULT_DETECTION_THRESHOLD=0.75
FIRE_SMOKE_ENABLED=true
FIRE_SMOKE_MODEL_PATH=fire_smoke.pt
FIRE_SMOKE_CONF_THRESHOLD=0.35
FIRE_SMOKE_IOU_THRESHOLD=0.45
# danger=true 판정 기준 (보호자 알림이 나가는 임계 — 추론 필터 CONF와 별개)
FIRE_SMOKE_DANGER_THRESHOLD=0.6
# 흉기(knife.pt, 클래스 knife만 인정 - knife_handle 무시)·낙상(fall.pt, 클래스 fallen -> 응답 "fall"). 기본 OFF
KNIFE_ENABLED=false
KNIFE_MODEL_PATH=knife.pt
KNIFE_CONF_THRESHOLD=0.25
KNIFE_DANGER_THRESHOLD=0.5
FALL_ENABLED=false
FALL_MODEL_PATH=fall.pt
FALL_CONF_THRESHOLD=0.25
# 낙상 danger = 최근 FALL_HOLD_SEC초 동안 분석된 장면 중 FALL_HOLD_RATIO 이상이 FALL_DANGER_THRESHOLD 이상
# (분석 간격이 FALL_HOLD_SEC보다 길면 낙상은 판정되지 않는다 - [FALL-HOLD-GAP] WARN)
FALL_DANGER_THRESHOLD=0.35
FALL_HOLD_SEC=1.5
FALL_HOLD_RATIO=0.7
# 화면 면적 대비 이 비율 이상인 낙상 상자는 무시(화면 공유 등 오탐 차단, 0 = 끔)
FALL_MAX_BOX_AREA=0.35
# 프레임당 추론 시간 요약 로그 주기(초, 0=끔) - 느리면 STREAM_SAMPLE_EVERY_N_FRAMES를 늘린다
STREAM_INFER_LOG_INTERVAL_SEC=60
STREAM_SAMPLE_EVERY_N_FRAMES=5
# 프레임 업로드 상한: 바이트(기본 4MB)·한 변 픽셀(기본 4096). 넘으면 413 STREAM_FRAME_TOO_LARGE
STREAM_FRAME_MAX_BYTES=4194304
STREAM_FRAME_MAX_SIDE=4096
STREAM_FALLBACK_INTERVAL_SEC=2
SAVE_NORMAL_RESULTS=true
LIVE_STREAM_DISCONNECT_TIMEOUT_SEC=10
STREAM_STATE_BACKEND=memory

# 실시간 영상(MJPEG·latest-frame)의 감지 박스(파란 테두리 + "fire 0.73" 라벨). 보여주는 복사본에만 그린다 -
# 분석 입력·클립은 원본 그대로. 문제가 생기면 LIVE_DRAW_BBOX=false 후 재기동(원본 바이트 그대로 송출).
LIVE_DRAW_BBOX=true
# 마지막 분석 결과를 박스로 유지하는 시간(초). 이 시간이 지나거나 감지 0건 결과가 오면 박스를 지운다
LIVE_BBOX_HOLD_SECONDS=1.0
# 박스 표시 기준. danger(기본) = 종류별 위험 기준(*_DANGER_THRESHOLD)과 같다 - 박스가 보이면 알림 기준을 넘은
# 것이다(낙상은 한 장 점수라 알림은 유지 조건까지 통과해야 나간다). 추론 후보 기준(*_CONF_THRESHOLD)과는 별개.
# 숫자(0~1)를 주면 모든 종류에 그 값을 쓴다(시연·디버깅용)
LIVE_BBOX_MIN_CONFIDENCE=danger
# 그리기 1회 상한(ms). 넘으면 박스 없이 원본을 내보낸다(영상 지연보다 박스 누락이 낫다)
LIVE_BBOX_DRAW_TIMEOUT_MS=150

# 이상감지 클립(POST /api/v1/live-streams/{sessionId}/clips) — 임시 파일만 쓰고 영구 저장은 백엔드가 한다
CLIP_ENABLED=true
CLIP_BUFFER_SECONDS=10
CLIP_MAX_FRAMES=100
# 링버퍼 바이트 상한(0 이하 = 끔). 넘으면 오래된 프레임부터 지우고, 전체 상한은 가장 큰 세션부터 줄인다
CLIP_SESSION_MAX_BYTES=67108864
CLIP_TOTAL_MAX_BYTES=536870912
CLIP_MIN_FRAMES=2
CLIP_BITRATE=3M
CLIP_MAX_CONCURRENCY=2

# 약 봉투 OCR(POST /api/v1/medication/ocr) — 키는 ANTHROPIC_API_KEY 공용. 생략하면 아래 기본값
# MEDICATION_OCR_ENABLED=true
# MEDICATION_OCR_MODEL=claude-sonnet-5-5  # haiku 금지(지정해도 sonnet 으로 대체)
# 챗봇 라우터·예약 추출 Claude 출력 상한(생각 토큰 포함). 생략하면 2048, 범위 256~8192 밖이면 기본값
# CLAUDE_MAX_TOKENS=2048
CLIP_QUEUE_MAX=10
CLIP_TIMEOUT_SEC=20
# 비우면 시스템 임시 디렉터리
CLIP_TMP_DIR=

# 학습용 프레임 수집 - 우리 카메라 환경(화질·각도·조명) 데이터를 모은다.
# ⚠️ 집 안 영상이다. 실제 사용자 카메라는 저장하지 말고, 허용한 팀 시험 세션만 COLLECT_SESSION_IDS 에 적는다
#    (쉼표 구분, 비어 있으면 아무것도 저장하지 않는다). 정확한 ID 또는 끝에 *를 붙인 접두어(ward_*)를 쓸 수 있다.
#    ward_* 는 이 서버에 붙는 모든 카메라가 대상이 되므로 팀원만 쓰는 테스트 서버에서만 쓴다(외부 사용자가 붙으면 정확한 ID로).
#    * 하나만 쓰면 전체 허용(기동 시 WARN). 내려받는 API 는 없다 - 서버에서 직접 옮기고, 다 쓰면 지운다.
COLLECT_ENABLED=false
COLLECT_SESSION_IDS=
COLLECT_DIR=/app/data/collect
# 위험 직전(near) 저장 하한 - 이 값 이상이고 그 종류의 위험 기준 미만(또는 낙상 유지 조건 전)
COLLECT_MIN_CONFIDENCE=0.2
COLLECT_DAILY_MAX_PER_SESSION=2000
COLLECT_MAX_TOTAL_GB=20
COLLECT_MIN_FREE_GB=5
COLLECT_RETENTION_DAYS=14
# 무작위 장면 수집(모델 비교용, reason=random). 점수와 무관하게 세션별로 간격마다 1장(±30%). 0 = 끔.
# 대상은 정확한 세션 ID 만(* 는 거부). 비면 저장 0. 위 COLLECT_ENABLED 도 켜져 있어야 한다.
COLLECT_RANDOM_INTERVAL_SEC=0
COLLECT_RANDOM_SESSION_IDS=
COLLECT_RANDOM_DAILY_MAX=300

MEDIAMTX_ENABLED=false
MEDIAMTX_WEBRTC_INGEST_BASE=
MEDIAMTX_WEBRTC_VIEW_BASE=
MEDIAMTX_HLS_VIEW_BASE=

# 보안 스위치 3종은 코드 기본값이 닫힘이다(.env 가 빠져도 열리지 않음). 열려면 명시적으로 바꾼다.
# WS ?apiKey= 쿼리 인증 허용(키가 URL·로그에 남음). 기본 false
WS_ALLOW_QUERY_API_KEY=false

# 챗 로그 상세 조회에 userId 필수(소유자 일치). 기본 true
CHAT_REQUIRE_USER_ID=true
# 게임 API(서버 간 호출 경로)에 X-API-Key 필수. 기본 true
GAME_REQUIRE_API_KEY=true

# uvicorn 바인딩 주소. 기본 0.0.0.0. 도커 브리지 등으로 직접 붙는 클라이언트가 있으면 기본값을 유지할 것
APP_HOST=0.0.0.0

# 문서 경로(/api/docs·/api/openapi.json·/api/redoc) 노출. false 면 404
DOCS_ENABLED=true

# 옛 카메라 등록·주소 접속 분석 API(/api/v1/cameras·/api/v1/analysis). 부르는 곳이 없어 기본은 끈다(404)
LEGACY_CAMERA_API_ENABLED=false

# 회원 데이터 삭제 뒤 같은 ID 로 기록·예약 계정을 새로 만들지 않는 시간(초, 기본 150). 재시작하면 비워진다
MEMBER_PURGE_HOLD_SEC=150

DOCS_PATH=/api/docs
OPENAPI_PATH=/api/openapi.json
REDOC_PATH=/api/redoc

# ---- 말벗·정서 분석 (companion). 값은 비워 둔다. 실제 값은 .env 에만 둔다 ----
COMPANION_API_KEY=
COMPANION_SESSION_LIMIT_SEC=0
COMPANION_MAX_TURNS=8
COMPANION_FRAME_INTERVAL_SEC=2.0
COMPANION_FRAME_MAX=5
COMPANION_FACE_MIN_RATE=0.5
COMPANION_CONFIDENCE_MIN=0.6
COMPANION_MIN_TEXT_CHARS=10
COMPANION_UPLOAD_MAX_MB=10
COMPANION_REPLY_MAX_CHARS=140
COMPANION_FUSION_RULE=plan41
COMPANION_STT_SUBDIR=companion/stt
COMPANION_STT_MODEL=large-v3
COMPANION_STT_DEVICE=cpu
COMPANION_STT_COMPUTE=int8
COMPANION_TEXT_EMOTION_SUBDIR=companion/text-emotion
COMPANION_FACE_MODEL_SUBDIR=companion/face-emotion
COMPANION_LLM_BASE_URL=
COMPANION_LLM_MODEL=
COMPANION_LLM_TIMEOUT_SEC=25
# 대화 모델은 GPU에 올리고, int8 이면 8비트로 줄인다 (GPU가 없으면 CPU에 올린다)
COMPANION_LLM_QUANT=int8
COMPANION_LLM_NUM_PREDICT=256
COMPANION_LLM_TEMPERATURE=0.1
COMPANION_LLM_RETRY=0
COMPANION_PSEUDONYM_SALT=
COMPANION_LOG_TRANSCRIPT=false
COMPANION_LOG_DATABASE_URL=
COMPANION_LOG_RETENTION_DAYS=30
COMPANION_NO_RESPONSE_LIMIT=3
COMPANION_STT_TIMEOUT_SEC=20
COMPANION_FACE_TIMEOUT_SEC=10
COMPANION_TEXT_TIMEOUT_SEC=5
COMPANION_RECORD_TIMEOUT_SEC=5
COMPANION_BASELINE_RATIO=2.0
COMPANION_BASELINE_WINDOW_DAYS=30
COMPANION_BASELINE_MIN_DAYS=20

# 챗 답 줄 머리 이모지(2026-11-09 기본 끔 - 어르신 화면은 문장만, 응급 답 핵심 줄은 119 전화 문장). 다시 켜려면 true
CHAT_LAYOUT_EMOJI=false

# Claude(라우터) 호출 실패 턴의 답 끝에 붙이는 안내 한 줄(2026-11-11, 응급·위기 답 제외). 끄려면 false
CHAT_DEGRADED_NOTICE=true

# --- 2차 점검 운영 설정 (2026-11-10) ---
# 실시간 분석 결과를 최신으로 인정하는 최대 나이(초)
LIVE_LATEST_ANALYSIS_MAX_AGE_SEC=30
# 실시간 WS 한 번 송신 제한 시간(초)
LIVE_WS_SEND_TIMEOUT_SEC=5
# 끊긴 실시간 세션 상태를 정리하기까지 시간(초)
LIVE_STALE_SESSION_PURGE_SEC=1800
# MedGemma 생성 자체의 시간 상한(초, 슬롯 대기와 별개)
MEDGEMMA_GENERATE_MAX_TIME_SEC=90
# PostgreSQL 연결 시간 제한(초)
DB_CONNECT_TIMEOUT_SEC=5
# DB 연결 풀에서 자리를 기다리는 시간(초)
DB_POOL_TIMEOUT_SEC=10
