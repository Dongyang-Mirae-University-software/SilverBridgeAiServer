APP_NAME=SilverBridge AI Server
APP_ENV=development
APP_VERSION=0.1.0
APP_PORT=6017
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=6019
POSTGRES_DB=silverbridge_ai
POSTGRES_USER=silverbridge_ai
POSTGRES_PASSWORD=silverbridge_ai_pw
DATABASE_URL=postgresql+psycopg2://silverbridge_ai:silverbridge_ai_pw@localhost:6019/silverbridge_ai
# 서버 .env 에만 실제 값을 넣는다(저장소·문서에 키를 쓰지 말 것)
API_KEY=<API_KEY>

MODEL_BASE_PATH=/app/models
UPLOAD_BASE_PATH=/app/uploads
SNAPSHOT_BASE_PATH=/app/uploads/snapshots
DEVICE_MAP=auto
TORCH_DTYPE=float16
REQUIRE_GPU=true

DEFAULT_CHAT_MODEL=google/medgemma-1.5-4b-it
CHAT_MODEL_PATH=
HF_TOKEN=

GPT_API_KEY=
GPT_MODEL_NAME=gpt-4o-mini
GPT_TIMEOUT_SEC=60

RESERVATION_API_BASE_URL=http://127.0.0.1:6015/api/v1
RESERVATION_API_TIMEOUT_SEC=120
RESERVATION_API_KEY=
RESERVATION_USER_JWT=
RESERVATION_ADMIN_JWT=
RESERVATION_SERVICE_EMAIL=user1@example.com
RESERVATION_SERVICE_PASSWORD=User123456!
# FE에서 발급받은 reservation API key를 저장해 두고 채팅 예약 호출에 재사용합니다.

DEFAULT_DETECTION_THRESHOLD=0.75
FIRE_SMOKE_ENABLED=true
FIRE_SMOKE_MODEL_PATH=fire_smoke.pt
FIRE_SMOKE_CONF_THRESHOLD=0.35
FIRE_SMOKE_IOU_THRESHOLD=0.45
# danger=true 판정 기준 (보호자 알림이 나가는 임계 — 추론 필터 CONF와 별개)
FIRE_SMOKE_DANGER_THRESHOLD=0.6
# 흉기(knife.pt, 클래스 knife만 인정 - knife_handle 무시)·낙상(fall.pt, 클래스 fallen -> 응답 "fall"). 기본 OFF
KNIFE_ENABLED=false
KNIFE_MODEL_PATH=knife.pt
KNIFE_CONF_THRESHOLD=0.25
KNIFE_DANGER_THRESHOLD=0.5
FALL_ENABLED=false
FALL_MODEL_PATH=fall.pt
FALL_CONF_THRESHOLD=0.25
# 낙상 danger = 최근 FALL_HOLD_SEC초 동안 분석된 장면 중 FALL_HOLD_RATIO 이상이 FALL_DANGER_THRESHOLD 이상
# (분석 간격이 FALL_HOLD_SEC보다 길면 낙상은 판정되지 않는다 - [FALL-HOLD-GAP] WARN)
FALL_DANGER_THRESHOLD=0.35
FALL_HOLD_SEC=1.5
FALL_HOLD_RATIO=0.7
# 프레임당 추론 시간 요약 로그 주기(초, 0=끔) - 느리면 STREAM_SAMPLE_EVERY_N_FRAMES를 늘린다
STREAM_INFER_LOG_INTERVAL_SEC=60
STREAM_SAMPLE_EVERY_N_FRAMES=5
STREAM_FALLBACK_INTERVAL_SEC=2
SAVE_NORMAL_RESULTS=true
LIVE_STREAM_DISCONNECT_TIMEOUT_SEC=10
STREAM_STATE_BACKEND=memory

# 실시간 영상(MJPEG·latest-frame)의 감지 박스(파란 테두리 + "fire 0.73" 라벨). 보여주는 복사본에만 그린다 -
# 분석 입력·클립은 원본 그대로. 문제가 생기면 LIVE_DRAW_BBOX=false 후 재기동(원본 바이트 그대로 송출).
LIVE_DRAW_BBOX=true
# 마지막 분석 결과를 박스로 유지하는 시간(초). 이 시간이 지나거나 감지 0건 결과가 오면 박스를 지운다
LIVE_BBOX_HOLD_SECONDS=1.0
# 박스 표시 기준. danger(기본) = 종류별 위험 기준(*_DANGER_THRESHOLD)과 같다 - 박스가 보이면 알림 기준을 넘은
# 것이다(낙상은 한 장 점수라 알림은 유지 조건까지 통과해야 나간다). 추론 후보 기준(*_CONF_THRESHOLD)과는 별개.
# 숫자(0~1)를 주면 모든 종류에 그 값을 쓴다(시연·디버깅용)
LIVE_BBOX_MIN_CONFIDENCE=danger
# 그리기 1회 상한(ms). 넘으면 박스 없이 원본을 내보낸다(영상 지연보다 박스 누락이 낫다)
LIVE_BBOX_DRAW_TIMEOUT_MS=150

# 이상감지 클립(POST /api/v1/live-streams/{sessionId}/clips) — 임시 파일만 쓰고 영구 저장은 백엔드가 한다
CLIP_ENABLED=true
CLIP_BUFFER_SECONDS=10
CLIP_MAX_FRAMES=100
# 링버퍼 바이트 상한(0 이하 = 끔). 넘으면 오래된 프레임부터 지우고, 전체 상한은 가장 큰 세션부터 줄인다
CLIP_SESSION_MAX_BYTES=67108864
CLIP_TOTAL_MAX_BYTES=536870912
CLIP_MIN_FRAMES=2
CLIP_BITRATE=3M
CLIP_MAX_CONCURRENCY=2
CLIP_QUEUE_MAX=10
CLIP_TIMEOUT_SEC=20
# 비우면 시스템 임시 디렉터리
CLIP_TMP_DIR=

MEDIAMTX_ENABLED=false
MEDIAMTX_WEBRTC_INGEST_BASE=
MEDIAMTX_WEBRTC_VIEW_BASE=
MEDIAMTX_HLS_VIEW_BASE=

# WS ?apiKey= 쿼리 인증 허용(키가 URL·로그에 남음). FE 가 헤더/백엔드 경유로 바꾸면 false
WS_ALLOW_QUERY_API_KEY=true

# 챗 로그 상세 조회에 userId 필수(소유자 일치). FE 가 상세 호출에 userId 를 붙인 뒤 true
CHAT_REQUIRE_USER_ID=false
# 게임 API 에 X-API-Key 필수. FE 피보호자 게임 iframe·embed 내부 호출이 프록시 경유로 바뀐 뒤 true
GAME_REQUIRE_API_KEY=false

DOCS_PATH=/api/docs
OPENAPI_PATH=/api/openapi.json
REDOC_PATH=/api/redoc
